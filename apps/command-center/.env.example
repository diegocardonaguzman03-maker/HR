# "mock" (default) runs the in-browser simulated engine.
# "real" connects RealAgentProvider to a WebSocket gateway (see server/gateway.ts).
NEXT_PUBLIC_AGENT_PROVIDER=mock
NEXT_PUBLIC_AGENT_WS_URL=ws://localhost:8787

# Gateway (server/) — PostgreSQL persistence. Unset = in-memory (not durable).
DATABASE_URL=postgres://fcc:fcc@localhost:5432/fcc
# Snapshot the world every N events (faster restarts).
SNAPSHOT_EVERY=200
# Gateway security. Default binds 127.0.0.1 (local only).
# HOST=127.0.0.1
# Required (>= 24 chars) if HOST is not loopback. Clients add ?token=… to the WS URL.
# GATEWAY_TOKEN=
# Browser origins allowed to connect (comma-separated).
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# LLM for real agents (server-side only). Never commit real keys: use a local .env (git-ignored).
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5
