{
  "name": "praxia-command-center",
  "version": "0.1.0",
  "private": true,
  "description": "PRAXIA Command Center — AI-native operating system for PRAXIA (Phase 0 + Phase 1 vertical slice).",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:seed": "tsx scripts/seed.mts",
    "db:seed:demo": "tsx scripts/seed-demo.mts",
    "db:reset": "tsx scripts/reset.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test",
    "artifact:build": "node artifact/build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@dnd-kit/core": "^6.3.1",
    "@libsql/client": "^0.15.15",
    "@radix-ui/react-dialog": "^1.2.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.54.0",
    "next": "^15.5.27",
    "pixi.js": "^8.22.0",
    "react": "19.2",
    "react-dom": "19.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@tailwindcss/postcss": "4.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "sql.js": "^1.13.0",
    "tailwindcss": "4.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
