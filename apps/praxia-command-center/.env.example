# Copy to .env.local. Never commit real secrets.
# SQLite file (libsql). For a hosted libsql/Turso DB use libsql://... plus PRAXIA_DB_AUTH_TOKEN.
PRAXIA_DB_URL=file:./data/praxia.db
# PRAXIA_DB_AUTH_TOKEN=

# Founder login. REQUIRED outside local development. Example values are rejected on purpose.
# PRAXIA_ADMIN_PASSWORD=   (at least 12 characters)
# PRAXIA_SESSION_SECRET=   (generate: openssl rand -base64 48)

# Local development only: run without login (non-production builds, bound to 127.0.0.1 by `npm run dev`).
# PRAXIA_DEV_OPEN=1
