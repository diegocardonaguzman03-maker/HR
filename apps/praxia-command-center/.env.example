# Copy to .env.local. Never commit real secrets.
# SQLite file (libsql). For a hosted libsql/Turso DB use libsql://... plus PRAXIA_DB_AUTH_TOKEN.
PRAXIA_DB_URL=file:./data/praxia.db
# PRAXIA_DB_AUTH_TOKEN=

# Founder login. Both are REQUIRED in production; the app refuses to serve without them.
PRAXIA_ADMIN_PASSWORD=change-me
PRAXIA_SESSION_SECRET=generate-a-random-string-of-at-least-32-characters
